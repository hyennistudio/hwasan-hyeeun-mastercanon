{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assets manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "path_or_url",
          "version",
          "status",
          "approval_source_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "type": {
            "enum": [
              "image",
              "video",
              "character_sheet",
              "other"
            ]
          },
          "path_or_url": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": [
              "string",
              "integer"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "confirmed",
              "disputed",
              "superseded"
            ]
          },
          "approval_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
