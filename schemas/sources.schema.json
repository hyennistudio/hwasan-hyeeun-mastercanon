{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "type",
          "path_or_url",
          "locator",
          "verification_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "original_text",
              "user_message",
              "document",
              "image",
              "video",
              "other"
            ]
          },
          "path_or_url": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_status": {
            "enum": [
              "unverified",
              "verified",
              "disputed"
            ]
          }
        }
      }
    }
  }
}
