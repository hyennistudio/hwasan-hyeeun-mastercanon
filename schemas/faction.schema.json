{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "faction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name_ko",
    "aliases",
    "universe",
    "record_status",
    "leader_ids",
    "member_ids",
    "territory",
    "flag_asset_ids",
    "facts",
    "approval",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name_ko": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "universe": {
      "const": "hwasan-hyeeun"
    },
    "record_status": {
      "enum": [
        "draft",
        "confirmed",
        "disputed",
        "superseded"
      ]
    },
    "leader_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "territory": {
      "type": [
        "string",
        "null"
      ]
    },
    "flag_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "status",
          "source_ids"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "status": {
            "enum": [
              "draft",
              "confirmed",
              "disputed",
              "superseded"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_at",
        "source_ids"
      ],
      "properties": {
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array"
    }
  }
}
